{
    "name": "@cookipedia/backend",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "ts-node-dev -r tsconfig-paths/register --watch ./src/emails/dist,./.env --rs --exit-child ./src/index.ts",
        "build-emails": "ts-node src/scripts/build-emails.ts",
        "copy-emails": "copyfiles ./src/emails/dist/*.html ./dist/backend",
        "build-ts": "rimraf ./dist && tsc --build ./tsconfig.json",
        "build": "pnpm build-ts && pnpm build-emails && pnpm copy-emails",
        "start": "node ./dist/backend/src/index.js",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts .",
        "types": "tsc --noEmit --project ./tsconfig.json",
        "pmd": "prisma migrate dev",
        "psc": "prisma generate",
        "prepare": "pnpm psc && ts-patch install -s"
    },
    "prisma": {
        "schema": "./src/prisma/schema.prisma"
    },
    "devDependencies": {
        "@cookipedia/shared": "workspace:*",
        "@cookipedia/webapp": "workspace:*",
        "@types/cors": "^2.8.19",
        "@types/cron": "^2.4.3",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.21",
        "@types/node": "^25.0.3",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/triple-beam": "^1.3.5",
        "eslint-plugin-node": "^11.1.0",
        "prisma": "^7.2.0",
        "rimraf": "^6.1.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "@prisma/config": "^7.2.0",
        "@sentry/node": "^10.53.1",
        "@trpc/server": "^11.8.1",
        "axios": "^1.13.5",
        "cors": "^2.8.5",
        "cron": "^4.4.0",
        "debug": "^4.4.3",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "fast-glob": "^3.3.3",
        "glob": "^13.0.1",
        "handlebars": "^4.7.8",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.17.21",
        "mjml": "^4.18.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.17.1",
        "picocolors": "^1.1.1",
        "resend": "^6.9.2",
        "serialize-error": "8.1.0",
        "superjson": "^2.2.6",
        "triple-beam": "^1.4.1",
        "trpc-playground": "^1.0.4",
        "winston": "^3.19.0",
        "yaml": "^2.8.3",
        "zod": "^4.3.5"
    }
}