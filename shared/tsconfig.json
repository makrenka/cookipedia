{
    "extends": "../backend/tsconfig.json",
    "include": ["src"],
    "compilerOptions": {
        "isolatedModules": true,
        "types": ["node", "jest"],
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./src",
        "outDir": "./dist",

        "declaration": true,
        "declarationMap": true,

        "strict": true
    }
}